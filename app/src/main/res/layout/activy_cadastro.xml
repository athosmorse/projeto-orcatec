<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- cabeçalho (ctrl + C em todas as telas)-->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/azul_orcatech">

        <Button
            android:id="@+id/barBt"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:backgroundTint="@color/black"
            android:layout_marginStart="4dp"/>

    </androidx.appcompat.widget.Toolbar>

    <!-- conteudo (ctrl + C em todas as telas)-->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- titulo -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cadastro de Projeto"
                android:textSize="24sp"
                android:gravity="center"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"/>

            <!-- Campos -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:text="NOME:"
                    android:textStyle="bold"/>

                <EditText
                    android:id="@+id/inputNome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Insira o nome..."/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:text="DATA INÍCIO:"
                    android:textStyle="bold"/>

                <EditText
                    android:id="@+id/inputDtIn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Selecione a data de início..."/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:text="DATA FIM:"
                    android:textStyle="bold"/>

                <EditText
                    android:id="@+id/inputDtFn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Selecione a data final..."/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:text="VALOR:"
                    android:textStyle="bold"/>

                <EditText
                    android:id="@+id/inputVlrCt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Insira o valor do contrato..."
                    android:inputType="numberDecimal"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:text="DESCRIÇÃO:"
                    android:textStyle="bold"/>

                <EditText
                    android:id="@+id/inputDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Descrição do projeto..."
                    android:minLines="3"
                    android:gravity="top"/>

            </LinearLayout>

            <!-- botao cadastrar -->
            <Button
                android:id="@+id/cad1Bt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:backgroundTint="@color/azul_orcatech"
                android:text="CADASTRAR"
                android:textColor="@color/white"
                app:cornerRadius="8dp"/>

        </LinearLayout>

    </ScrollView>

</LinearLayout>