<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- cabeçalho (ctrl + C em todas as telas)-->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/azul_orcatech">

        <Button
            android:id="@+id/barBt"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:backgroundTint="@color/black"
            android:layout_marginStart="4dp"/>

    </androidx.appcompat.widget.Toolbar>

    <!-- mudei uma linha dentro do build.gradle.kts, que é necessario pra essa página aqui -->
    <!-- dentro de dependencies, coloquei a seguinte linha de codigo -->
    <!-- implementation(libs.recyclerview) -->

    <!-- dentro de libs.versions.toml coloquei isso dentro de [version]-->
    <!-- recyclerview = "1.3.2" -->
    <!-- dentro de [libraries] coloquei isso aqui -->
    <!-- recyclerview = { group = "androidx.recyclerview", name = "recyclerview", version.ref = "recyclerview" [plugins] -->

    <!-- resumindo: ele adiciona uma biblioteca que eu preciso usar pra essa tela -->

    <!-- titulo -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Projetos"
        android:textSize="24sp"
        android:gravity="center"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"/>

    <!-- filtros -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btTodos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TODOS"
            android:backgroundTint="#929292"
            android:textColor="@color/white"
            app:cornerRadius="4dp"/>

        <Button
            android:id="@+id/btAndamento"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ANDAMENTO"
            android:backgroundTint="@color/azul_orcatech"
            android:textColor="@color/white"
            app:cornerRadius="4dp"/>

        <Button
            android:id="@+id/btConcluidos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CONCLUÍDOS"
            android:backgroundTint="#00A510"
            android:textColor="@color/white"
            app:cornerRadius="4dp"/>

    </LinearLayout>

    <!-- Lista de Projetos -->

    <!-- Lista + Botão flutuante -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerProjetos"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp"/>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/addProjeto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:backgroundTint="@color/azul_orcatech"
            app:srcCompat="@android:drawable/ic_input_add"/>

    </FrameLayout>

</LinearLayout>